@page "/"

<PageTitle>Apex Coaching — Online Personal Training</PageTitle>

<section class="hero">
    <div class="hero-inner">
        <p class="eyebrow">ONLINE PERSONAL TRAINING</p>
        <h1>Train smarter. Get results that last.</h1>
        <p class="lead">
            Custom workout and nutrition programming built around your body, your goals,
            and your schedule — coached online, wherever you are.
        </p>
        <div class="hero-cta">
            <a class="btn btn-primary btn-lg" href="/trainers">Find your trainer</a>
            <a class="btn btn-outline-light btn-lg" href="/demo">See the client experience</a>
        </div>
    </div>
</section>

<section class="features">
    <div class="feature-card">
        <div class="feature-icon">🏋️</div>
        <h3>Personalized programming</h3>
        <p>Every program is built from your assessment — strength, mobility, injury history, and equipment.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">🥗</div>
        <h3>Nutrition that fits you</h3>
        <p>Meal guidance and macros matched to your goals and food preferences — no fad diets.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">📈</div>
        <h3>Accountability &amp; tracking</h3>
        <p>Check-ins, progress reviews, and adjustments so your plan keeps working as you do.</p>
    </div>
</section>

<section class="cta-band">
    <h2>Ready to start?</h2>
    <p>Browse vetted coaches, pick a plan, and we'll map out your first 12 weeks.</p>
    <a class="btn btn-primary btn-lg" href="/trainers">Browse trainers</a>
</section>
