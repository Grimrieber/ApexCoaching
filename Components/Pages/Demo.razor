@page "/demo"
@rendermode InteractiveServer

<PageTitle>Client Demo — Apex Coaching</PageTitle>

<section class="page-head">
    <p class="eyebrow-dark">LIVE DEMO</p>
    <h1>Your client dashboard</h1>
    <p class="lead">A peek at what a coached client sees each day. Everything here is interactive — try it.</p>
</section>

<div class="dash">
    <!-- Today's workout -->
    <div class="dash-card workout">
        <div class="dash-card-head">
            <h3>Today · Push Day</h3>
            <span class="pill">@CompletedCount/@exercises.Count done</span>
        </div>
        <div class="progress-track"><div class="progress-fill" style="width:@(ProgressPercent)%"></div></div>

        @foreach (var ex in exercises)
        {
            <label class="ex-row @(ex.Done ? "done" : "")">
                <input type="checkbox" checked="@ex.Done" @onchange="@(e => Toggle(ex, e))" />
                <span class="ex-name">@ex.Name</span>
                <span class="ex-meta">@ex.Sets × @ex.Reps</span>
            </label>
        }

        @if (CompletedCount == exercises.Count)
        {
            <div class="success-note">🔥 Workout complete — nice work! Your coach has been notified.</div>
        }
    </div>

    <!-- Stats + log -->
    <div class="dash-col">
        <div class="dash-card">
            <div class="dash-card-head"><h3>This week</h3></div>
            <div class="stat-row">
                <div class="stat"><span class="stat-num">3</span><span class="stat-label">Workouts</span></div>
                <div class="stat"><span class="stat-num">1,980</span><span class="stat-label">Avg kcal</span></div>
                <div class="stat"><span class="stat-num">@bodyLog.Count</span><span class="stat-label">Weigh-ins</span></div>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-card-head"><h3>Quick log · Bodyweight</h3></div>
            <div class="log-input">
                <input type="number" step="0.1" placeholder="lbs" @bind="newWeight" class="form-control" />
                <button class="btn btn-primary" @onclick="LogWeight">Log</button>
            </div>
            @if (bodyLog.Count > 0)
            {
                <ul class="log-list">
                    @foreach (var w in bodyLog)
                    {
                        <li><span>Entry @w.Item1</span><strong>@w.Item2 lbs</strong></li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">No entries yet — log your first weigh-in above.</p>
            }
        </div>

        <div class="dash-card coach-note">
            <div class="dash-card-head"><h3>Message from your coach</h3></div>
            <p>"Great consistency this week — let's add 5 lbs to your bench next session. 💪"</p>
        </div>
    </div>
</div>

<p class="fine-print">Demo data only — not connected to a database yet. This shows the kind of client experience we'd build out.</p>

@code {
    private record Exercise(string Name, int Sets, string Reps) { public bool Done { get; set; } }

    private List<Exercise> exercises = new()
    {
        new("Barbell Bench Press", 4, "6-8"),
        new("Incline Dumbbell Press", 3, "8-10"),
        new("Overhead Press", 3, "8-10"),
        new("Cable Fly", 3, "12-15"),
        new("Triceps Pushdown", 3, "12-15"),
    };

    private List<(int, double)> bodyLog = new();
    private double? newWeight;

    private int CompletedCount => exercises.Count(e => e.Done);
    private int ProgressPercent => exercises.Count == 0 ? 0 : (int)(100.0 * CompletedCount / exercises.Count);

    private void Toggle(Exercise ex, ChangeEventArgs e) => ex.Done = (bool)(e.Value ?? false);

    private void LogWeight()
    {
        if (newWeight is double w && w > 0)
        {
            bodyLog.Insert(0, (bodyLog.Count + 1, w));
            newWeight = null;
        }
    }
}
