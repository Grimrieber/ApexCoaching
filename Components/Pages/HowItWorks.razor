@page "/how-it-works"

<PageTitle>How it works — Apex Coaching</PageTitle>

<section class="page-head">
    <h1>How online coaching works</h1>
    <p class="lead">Real coaching, built around your life — in four simple steps.</p>
</section>

<section class="features">
    <div class="feature-card">
        <div class="feature-icon">1️⃣</div>
        <h3>Find your coach</h3>
        <p>Browse vetted trainers by specialty and pick the one who fits your goals.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">2️⃣</div>
        <h3>Choose a plan</h3>
        <p>Pick a monthly package. Secure checkout — cancel anytime.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">3️⃣</div>
        <h3>Get your program</h3>
        <p>Your coach builds a custom training &amp; nutrition plan in your dashboard.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">4️⃣</div>
        <h3>Train &amp; check in</h3>
        <p>Follow your plan, log progress, and get weekly adjustments and accountability.</p>
    </div>
</section>

<section class="cta-band" style="margin-top:1rem;">
    <h2>Want to see it first?</h2>
    <p>Take a look at the interactive client dashboard.</p>
    <a class="btn btn-primary btn-lg" href="/demo">View the live demo</a>
</section>
