@page "/pricing"

<PageTitle>Pricing — Apex Coaching</PageTitle>

<section class="page-head">
    <h1>Straightforward pricing</h1>
    <p class="lead">Typical monthly coaching tiers. Each trainer sets their own rates — these are the ranges you'll see.</p>
</section>

<section class="pricing">
    <div class="price-card">
        <h3>Starter</h3>
        <p class="price">$99<span>/mo</span></p>
        <ul>
            <li>Custom training program</li>
            <li>Monthly check-in</li>
            <li>App &amp; messaging support</li>
        </ul>
        <a class="btn btn-outline-primary" href="/trainers">Find a trainer</a>
    </div>
    <div class="price-card featured">
        <p class="badge-pop">Most popular</p>
        <h3>Coached</h3>
        <p class="price">$199<span>/mo</span></p>
        <ul>
            <li>Training <em>and</em> nutrition programming</li>
            <li>Weekly check-ins &amp; adjustments</li>
            <li>Video form reviews</li>
            <li>Priority messaging</li>
        </ul>
        <a class="btn btn-primary" href="/trainers">Find a trainer</a>
    </div>
    <div class="price-card">
        <h3>1:1 Premium</h3>
        <p class="price">$349<span>/mo</span></p>
        <ul>
            <li>Everything in Coached</li>
            <li>Live video sessions</li>
            <li>Daily accountability</li>
        </ul>
        <a class="btn btn-outline-primary" href="/trainers">Find a trainer</a>
    </div>
</section>

<section class="cta-band" style="margin-top:2rem;">
    <h2>Are you a trainer?</h2>
    <p>List your services, get matched with clients, and we handle payments. You keep 80% — we take a simple 20% platform fee.</p>
    <a class="btn btn-primary btn-lg" href="/Account/Register">Become a coach</a>
</section>
